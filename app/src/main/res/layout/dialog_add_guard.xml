<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="22dp">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Add Guard"
        android:textColor="#1A1A1A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Enter guard information"
        android:textColor="#888888"
        android:textSize="12sp" />

    <!-- Full Name -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Full Name"
        android:textColor="#333333"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtGuardName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="7dp"
        android:background="#F5F5F5"
        android:hint="Enter full name"
        android:inputType="textPersonName"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#222222"
        android:textColorHint="#AAAAAA"
        android:textSize="13sp" />

    <!-- Mobile Number -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="Mobile Number"
        android:textColor="#333333"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtGuardMobile"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="7dp"
        android:background="#F5F5F5"
        android:hint="Enter mobile number"
        android:inputType="phone"
        android:maxLength="10"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#222222"
        android:textColorHint="#AAAAAA"
        android:textSize="13sp" />

    <!-- Guard ID -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="Guard ID"
        android:textColor="#333333"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtGuardId"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="7dp"
        android:background="#F1F1F1"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="GUARD-001"
        android:textColor="#555555"
        android:textSize="13sp" />

    <!-- Username -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="Username"
        android:textColor="#333333"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/edtGuardUsername"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="7dp"
        android:background="#F5F5F5"
        android:hint="Enter username"
        android:inputType="text"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#222222"
        android:textColorHint="#AAAAAA"
        android:textSize="13sp" />

    <!-- Assigned Gate / Shift -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:text="Assigned Gate / Shift"
        android:textColor="#333333"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinnerGateShift"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="7dp"
        android:background="#F5F5F5"
        android:paddingStart="10dp"
        android:paddingEnd="10dp" />

    <!-- Password Information -->
    <TextView
        android:id="@+id/txtPasswordInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:background="#FCEDEF"
        android:padding="12dp"
        android:text="Login password will be generated automatically by the system."
        android:textColor="#A10D25"
        android:textSize="11sp" />

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelAddGuard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="#F1F1F1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="CANCEL"
            android:textColor="#555555"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSaveGuard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="#C8102E"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="ADD GUARD"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

</LinearLayout>