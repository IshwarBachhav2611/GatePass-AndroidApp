<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="340dp"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Accepted Visitors"
        android:textColor="#1A1A1A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Date -->
    <TextView
        android:id="@+id/txtSelectedDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="01 October 2026"
        android:textColor="#777777"
        android:textSize="12sp" />

    <!-- Visitor 1 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        app:cardBackgroundColor="#F8F8F8"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- Name + Token -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtVisitorName1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="John Doe"
                        android:textColor="#222222"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtReason1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Official Meeting"
                        android:textColor="#777777"
                        android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtToken1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#EAF7EF"
                    android:paddingStart="9dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="6dp"
                    android:text="GP-001"
                    android:textColor="#238B45"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Date & Time -->
            <TextView
                android:id="@+id/txtDateTime1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="01 Oct 2026  •  10:30 AM"
                android:textColor="#888888"
                android:textSize="10sp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <!-- Visitor 2 -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        app:cardBackgroundColor="#F8F8F8"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtVisitorName2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sneha Patil"
                        android:textColor="#222222"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtReason2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Interview"
                        android:textColor="#777777"
                        android:textSize="11sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/txtToken2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#EAF7EF"
                    android:paddingStart="9dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="6dp"
                    android:text="GP-002"
                    android:textColor="#238B45"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtDateTime2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="01 Oct 2026  •  11:15 AM"
                android:textColor="#888888"
                android:textSize="10sp" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>


    <!-- Close -->
    <TextView
        android:id="@+id/btnCloseVisitors"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="18dp"
        android:background="#EEEEEE"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="CLOSE"
        android:textColor="#444444"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>